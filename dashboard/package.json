{
  "name": "devinquire-dashboard",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://dashboard.devinquire.com",
  "dependencies": {
    "@firebase/auth": "^1.10.7",
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/forms": "^0.5.10",
    "axios": "^1.12.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase": "^11.9.1",
    "firebase-admin": "^13.5.0",
    "framer-motion": "^12.18.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.541.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-firebase-hooks": "^5.1.1",
    "react-hot-toast": "^2.6.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.21.0",
    "react-scripts": "^5.0.1",
    "typewriter-effect": "^2.22.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.14",
    "dotenv": "^17.2.1",
    "postcss": "^8.4.21",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^13.0.2",
    "tailwindcss": "^3.4.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:prod": "NODE_ENV=production react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "server": "node server-blog-api.js",
    "dev:server": "nodemon server-blog-api.js",
    "setup": "node scripts/setup-config.js",
    "setup:prod": "cp env.production.example .env.production && echo '✅ Created .env.production - please edit with your Firebase credentials'",
    "predeploy": "npm run build",
    "deploy:vercel": "vercel --prod",
    "deploy:netlify": "netlify deploy --prod --dir=build",
    "deploy:firebase": "firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules,storage:rules",
    "deploy:all": "npm run build && firebase deploy",
    "verify:build": "npm run build && echo '✅ Build successful! Check the build/ directory.'",
    "verify:env": "node -e \"require('dotenv').config({path:'.env.production'}); console.log('✅ Environment variables loaded')\"",
    "prepare:deploy": "node prepare-deployment.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
