{
    "name": "devinquire/backend",
    "description": "Simplified PHP Backend for DevInquire Dashboard - Hostinger Shared Hosting Compatible",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "firebase/php-jwt": "^6.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "DevInquire\\Backend\\": "src/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 index.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "7.4"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}