rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Enhanced security functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    
    function isEditor() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'editor'] &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    
    function isAuthor() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'editor', 'author'] &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }
    
    function canManageContent() {
      return isAuthor();
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function canReadUser(targetUserId) {
      return isAuthenticated() && 
             (isOwner(targetUserId) || isAdmin());
    }
    
    function canWriteUser(targetUserId) {
      return isOwner(targetUserId) || isAdmin();
    }
    
    // Enhanced validation functions
    function isValidUserData() {
      return request.resource.data.keys().hasAll(['email', 'name', 'role', 'status', 'metadata']) &&
             request.resource.data.email is string &&
             request.resource.data.name is string &&
             request.resource.data.role in ['user', 'author', 'editor', 'admin'] &&
             request.resource.data.status in ['active', 'inactive', 'pending'] &&
             request.resource.data.metadata is map &&
             request.resource.data.email.matches('.*@.*\\..*') && // Basic email validation
             request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100;
    }
    
    function isValidPostData() {
      return request.resource.data.keys().hasAll(['title', 'content', 'authorId', 'status', 'metadata']) &&
             request.resource.data.title is string &&
             request.resource.data.content is string &&
             request.resource.data.authorId == request.auth.uid &&
             request.resource.data.status in ['draft', 'published', 'archived'] &&
             request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200 &&
             request.resource.data.content.size() <= 50000; // 50KB content limit
    }
    
    function isValidPageData() {
      return request.resource.data.keys().hasAll(['title', 'content', 'slug', 'status', 'metadata']) &&
             request.resource.data.title is string &&
             request.resource.data.content is string &&
             request.resource.data.slug is string &&
             request.resource.data.status in ['draft', 'published', 'archived'] &&
             request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200 &&
             request.resource.data.slug.matches('^[a-z0-9-]+$') && // URL-safe slug
             request.resource.data.slug.size() > 0 && request.resource.data.slug.size() <= 100 &&
             request.resource.data.content.size() <= 100000; // 100KB content limit
    }
    
    function isValidUpdateData(requiredFields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(requiredFields.concat(['updatedAt']));
    }
    
    function hasValidTimestamp() {
      return request.resource.data.updatedAt == request.time;
    }
    
    // Users collection rules
    match /users/{userId} {
      allow read: if canReadUser(userId);
      allow create: if isAuthenticated() && request.auth.uid == userId && isValidUserData();
      allow update: if canWriteUser(userId) && isValidUserData();
      allow delete: if isAdmin();
      
      // User subcollections (sessions, preferences, etc.)
      match /{document=**} {
        allow read, write: if canReadUser(userId);
      }
    }
    
    // Posts collection rules
    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || 
                     (isAuthenticated() && (resource.data.authorId == request.auth.uid || canManageContent()));
      allow create: if canManageContent() && isValidPostData() && hasValidTimestamp();
      allow update: if canManageContent() && 
                       (resource.data.authorId == request.auth.uid || isEditor()) &&
                       isValidPostData() && hasValidTimestamp() &&
                       isValidUpdateData(['title', 'content', 'status', 'excerpt', 'featuredImage', 'slug', 'metadata']);
      allow delete: if isEditor() && 
                       (resource.data.authorId == request.auth.uid || isAdmin());
      
      // Post revisions subcollection
      match /revisions/{revisionId} {
        allow read: if resource.data.authorId == request.auth.uid || canManageContent();
        allow create: if false; // Only server functions can create revisions
        allow update, delete: if false;
      }
    }
    
    // Pages collection rules
    match /pages/{pageId} {
      allow read: if resource.data.status == 'published' || 
                     (isAuthenticated() && canManageContent());
      allow create: if canManageContent() && isValidPageData() && hasValidTimestamp();
      allow update: if canManageContent() && isValidPageData() && hasValidTimestamp() &&
                       isValidUpdateData(['title', 'content', 'slug', 'template', 'status', 'seo', 'settings', 'metadata']);
      allow delete: if isEditor();
      
      // Page revisions subcollection
      match /revisions/{revisionId} {
        allow read: if canManageContent();
        allow create: if false; // Only server functions can create revisions
        allow update, delete: if false;
      }
    }
    
    // Analytics collection (admin read-only)
    match /analytics/{document} {
      allow read: if isAdmin();
      allow write: if false; // Analytics data should only be written by server-side functions
    }
    
    // Settings collection (admin only)
    match /settings/{document} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Sessions collection (user-specific)
    match /sessions/{sessionId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && 
                       (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && 
                       (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Comments collection
    match /comments/{commentId} {
      allow read: if resource.data.status == 'approved' || 
                     (isAuthenticated() && (resource.data.authorId == request.auth.uid || canManageContent()));
      allow create: if isAuthenticated() && 
                       request.resource.data.authorId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['content', 'postId', 'authorId', 'status']) &&
                       request.resource.data.content.size() > 0 && request.resource.data.content.size() <= 1000;
      allow update: if isAuthenticated() && 
                       (resource.data.authorId == request.auth.uid || canManageContent()) &&
                       isValidUpdateData(['content', 'status']);
      allow delete: if isAuthenticated() && 
                       (resource.data.authorId == request.auth.uid || isEditor());
    }
    
    // Media/Files collection
    match /media/{mediaId} {
      allow read: if isAuthenticated();
      allow create: if canManageContent() && 
                       request.resource.data.keys().hasAll(['fileName', 'fileSize', 'mimeType', 'uploadedBy']) &&
                       request.resource.data.uploadedBy == request.auth.uid &&
                       request.resource.data.fileSize <= 10485760; // 10MB limit
      allow update: if canManageContent() && 
                       (resource.data.uploadedBy == request.auth.uid || isEditor()) &&
                       isValidUpdateData(['fileName', 'alt', 'caption', 'metadata']);
      allow delete: if canManageContent() && 
                       (resource.data.uploadedBy == request.auth.uid || isEditor());
    }
    
    // Categories collection
    match /categories/{categoryId} {
      allow read: if true; // Public read access
      allow create, update, delete: if isEditor();
    }
    
    // Tags collection
    match /tags/{tagId} {
      allow read: if true; // Public read access
      allow create, update, delete: if canManageContent();
    }
    
    // Default deny rule for any unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}