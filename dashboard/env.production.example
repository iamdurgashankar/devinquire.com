# ============================================
# DevInquire Dashboard - Production Environment
# ============================================
# Copy this file to .env.production and fill in your values
# This file is used when building for production (npm run build)

# ============================================
# Firebase Configuration (REQUIRED)
# ============================================
REACT_APP_FIREBASE_API_KEY=your-firebase-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
REACT_APP_FIREBASE_APP_ID=your-app-id
REACT_APP_FIREBASE_MEASUREMENT_ID=G-your-measurement-id

# ============================================
# Authentication Settings
# ============================================
REACT_APP_REQUIRE_EMAIL_VERIFICATION=false
REACT_APP_SESSION_TIMEOUT=7776000000
REACT_APP_MAX_LOGIN_ATTEMPTS=5
REACT_APP_ENABLE_MFA=false
REACT_APP_REQUIRE_USER_APPROVAL=false

# ============================================
# Performance & Features
# ============================================
REACT_APP_ENABLE_REAL_TIME_UPDATES=true
REACT_APP_ENABLE_OFFLINE_SUPPORT=true
REACT_APP_CACHE_SIZE_MB=40
REACT_APP_ENABLE_PERFORMANCE_MONITORING=true

# ============================================
# Application Settings
# ============================================
NODE_ENV=production
REACT_APP_ENV=production

