rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for role-based access control
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    function hasAnyRole(roles) {
      return isAuthenticated() && getUserData().role in roles;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isActiveUser() {
      return isAuthenticated() && 
             getUserData().status == 'active' && 
             getUserData().approvalStatus.status == 'approved';
    }
    
    function isSuperAdmin() {
      return hasRole('SUPER_ADMIN');
    }
    
    function isAdmin() {
      return hasAnyRole(['SUPER_ADMIN', 'ADMIN']);
    }
    
    function isModerator() {
      return hasAnyRole(['SUPER_ADMIN', 'ADMIN', 'MODERATOR']);
    }
    
    function isAuthor() {
      return hasAnyRole(['SUPER_ADMIN', 'ADMIN', 'MODERATOR', 'AUTHOR']);
    }
    
    function canManageUsers() {
      return isAdmin();
    }
    
    function canModerateContent() {
      return isModerator();
    }
    
    function canCreateContent() {
      return isAuthor() && isActiveUser();
    }
    
    function isValidUserData(data) {
      return data.keys().hasAll(['email', 'role', 'status', 'createdAt', 'approvalStatus']) &&
             data.role in ['SUPER_ADMIN', 'ADMIN', 'MODERATOR', 'AUTHOR', 'USER', 'PENDING', 'SUSPENDED', 'BANNED'] &&
             data.status in ['active', 'inactive', 'suspended', 'banned'] &&
             data.approvalStatus.keys().hasAll(['status', 'timestamp']) &&
             data.approvalStatus.status in ['pending', 'approved', 'rejected'];
    }
    
    function isValidRoleTransition(oldRole, newRole) {
      // Super admins can assign any role
      return isSuperAdmin() ||
      // Admins can assign roles below admin level
      (isAdmin() && newRole in ['MODERATOR', 'AUTHOR', 'USER', 'PENDING', 'SUSPENDED', 'BANNED']) ||
      // Moderators can only assign user-level roles
      (isModerator() && newRole in ['AUTHOR', 'USER', 'PENDING', 'SUSPENDED']);
    }
    
    // Users collection - stores user profiles and roles
    match /users/{userId} {
      // Read: Users can read their own profile, admins can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // Create: Only during user registration (handled by Cloud Functions)
      allow create: if isAuthenticated() && 
                       isOwner(userId) && 
                       isValidUserData(resource.data) &&
                       resource.data.role == 'PENDING' &&
                       resource.data.status == 'inactive' &&
                       resource.data.approvalStatus.status == 'pending';
      
      // Update: Users can update their own profile (limited fields), admins can update roles
      allow update: if isOwner(userId) && 
                       // Users can only update specific fields
                       request.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'preferences', 'lastLoginAt']) ||
                    // Admins can update roles and status
                    (canManageUsers() && 
                     isValidUserData(request.data) &&
                     isValidRoleTransition(resource.data.role, request.data.role));
      
      // Delete: Only super admins can delete users
      allow delete: if isSuperAdmin();
    }
    
    // User sessions collection - tracks active sessions
    match /userSessions/{sessionId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin(); // Admins can view all sessions
      allow delete: if isAdmin(); // Admins can terminate sessions
    }
    
    // Admin actions log - tracks administrative actions
    match /adminActions/{actionId} {
      // Only admins can read admin actions
      allow read: if isAdmin();
      
      // Only system (Cloud Functions) can create admin action logs
      allow create: if false; // Handled by Cloud Functions only
      
      // No updates or deletes allowed
      allow update, delete: if false;
    }
    
    // Blog posts collection
    match /posts/{postId} {
      // Read: Published posts are public, drafts only by author/moderators
      allow read: if resource.data.status == 'published' ||
                     isOwner(resource.data.authorId) ||
                     canModerateContent();
      
      // Create: Only authors can create posts
      allow create: if canCreateContent() && 
                       isOwner(resource.data.authorId) &&
                       resource.data.status in ['draft', 'pending_review'];
      
      // Update: Authors can update their own posts, moderators can update any
      allow update: if (isOwner(resource.data.authorId) && isActiveUser()) ||
                       canModerateContent();
      
      // Delete: Authors can delete their own posts, moderators can delete any
      allow delete: if (isOwner(resource.data.authorId) && isActiveUser()) ||
                       canModerateContent();
    }
    
    // Comments collection
    match /comments/{commentId} {
      // Read: Comments on published posts are public
      allow read: if true; // Comments are generally public
      
      // Create: Active users can create comments
      allow create: if isActiveUser() && 
                       isOwner(resource.data.authorId);
      
      // Update: Users can edit their own comments, moderators can edit any
      allow update: if (isOwner(resource.data.authorId) && isActiveUser()) ||
                       canModerateContent();
      
      // Delete: Users can delete their own comments, moderators can delete any
      allow delete: if (isOwner(resource.data.authorId) && isActiveUser()) ||
                       canModerateContent();
    }
    
    // Categories collection
    match /categories/{categoryId} {
      // Read: Categories are public
      allow read: if true;
      
      // Write: Only moderators can manage categories
      allow create, update, delete: if canModerateContent();
    }
    
    // Tags collection
    match /tags/{tagId} {
      // Read: Tags are public
      allow read: if true;
      
      // Write: Authors can create tags, moderators can manage all
      allow create: if canCreateContent();
      allow update, delete: if canModerateContent();
    }
    
    // Media/Files collection
    match /media/{mediaId} {
      // Read: Media files are generally accessible based on post visibility
      allow read: if true; // Media access controlled by post access
      
      // Create: Authors can upload media
      allow create: if canCreateContent() && 
                       isOwner(resource.data.uploadedBy);
      
      // Update: Only the uploader or moderators can update
      allow update: if (isOwner(resource.data.uploadedBy) && isActiveUser()) ||
                       canModerateContent();
      
      // Delete: Only the uploader or moderators can delete
      allow delete: if (isOwner(resource.data.uploadedBy) && isActiveUser()) ||
                       canModerateContent();
    }
    
    // Site settings collection
    match /settings/{settingId} {
      // Read: Some settings are public, others admin-only
      allow read: if resource.data.public == true || isAdmin();
      
      // Write: Only admins can modify settings
      allow create, update, delete: if isAdmin();
    }
    
    // Analytics collection
    match /analytics/{analyticsId} {
      // Read: Only admins can read analytics
      allow read: if isAdmin();
      
      // Write: Only system can write analytics (Cloud Functions)
      allow create, update: if false; // Handled by Cloud Functions
      allow delete: if isSuperAdmin();
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      // Read: Users can read their own notifications, admins can read all
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      // Create: System creates notifications (Cloud Functions)
      allow create: if false; // Handled by Cloud Functions
      
      // Update: Users can mark their notifications as read
      allow update: if isOwner(resource.data.userId) && 
                       request.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      
      // Delete: Users can delete their own notifications
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // User preferences collection
    match /userPreferences/{userId} {
      // Read/Write: Users can manage their own preferences
      allow read, write: if isOwner(userId);
      
      // Admins can read preferences for support purposes
      allow read: if isAdmin();
    }
    
    // Audit logs collection
    match /auditLogs/{logId} {
      // Read: Only admins can read audit logs
      allow read: if isAdmin();
      
      // Write: Only system can write audit logs (Cloud Functions)
      allow create, update, delete: if false; // Handled by Cloud Functions only
    }
    
    // Feedback/Contact forms collection
    match /feedback/{feedbackId} {
      // Read: Users can read their own feedback, admins can read all
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      // Create: Authenticated users can submit feedback
      allow create: if isAuthenticated() && isOwner(resource.data.userId);
      
      // Update: Admins can update status/response
      allow update: if isAdmin();
      
      // Delete: Only super admins can delete feedback
      allow delete: if isSuperAdmin();
    }
    
    // Email templates collection
    match /emailTemplates/{templateId} {
      // Read: Admins can read templates
      allow read: if isAdmin();
      
      // Write: Only admins can manage email templates
      allow create, update, delete: if isAdmin();
    }
    
    // System configuration
    match /systemConfig/{configId} {
      // Read: Admins can read system config
      allow read: if isAdmin();
      
      // Write: Only super admins can modify system config
      allow create, update, delete: if isSuperAdmin();
    }
    
    // Default deny rule for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}