# ============================================
# DevInquire Dashboard - Environment Configuration
# ============================================
# Copy this file to .env.local and fill in your values
# For production builds, use .env.production

# ============================================
# Firebase Configuration (REQUIRED)
# ============================================
# Get these from Firebase Console → Project Settings → General → Your apps
REACT_APP_FIREBASE_API_KEY=your-firebase-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
REACT_APP_FIREBASE_APP_ID=your-app-id
REACT_APP_FIREBASE_MEASUREMENT_ID=G-your-measurement-id

# Optional: Firebase Realtime Database URL (if using)
REACT_APP_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# ============================================
# Authentication Settings
# ============================================
REACT_APP_REQUIRE_EMAIL_VERIFICATION=false
REACT_APP_SESSION_TIMEOUT=1800000
REACT_APP_MAX_LOGIN_ATTEMPTS=5
REACT_APP_ENABLE_MFA=false
REACT_APP_REQUIRE_USER_APPROVAL=false

# ============================================
# Performance & Features
# ============================================
REACT_APP_ENABLE_REAL_TIME_UPDATES=true
REACT_APP_ENABLE_OFFLINE_SUPPORT=true
REACT_APP_CACHE_SIZE_MB=40
REACT_APP_ENABLE_PERFORMANCE_MONITORING=true

# ============================================
# Development Settings (Optional)
# ============================================
# Set to true to use Firebase emulators locally
REACT_APP_USE_FIREBASE_EMULATOR=false
REACT_APP_FIREBASE_EMULATOR_HOST=localhost
REACT_APP_FIREBASE_AUTH_EMULATOR_PORT=9099
REACT_APP_FIREBASE_FIRESTORE_EMULATOR_PORT=8080
REACT_APP_FIREBASE_STORAGE_EMULATOR_PORT=9199
REACT_APP_FIREBASE_FUNCTIONS_EMULATOR_PORT=5001

# ============================================
# Application Settings
# ============================================
NODE_ENV=development
REACT_APP_ENV=development

