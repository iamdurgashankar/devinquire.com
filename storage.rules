rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }
    
    function isApprovedUser() {
      return request.auth != null && request.auth.token.status == 'approved';
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // Images and general uploads
    match /uploads/{allPaths=**} {
      // Allow authenticated users to read uploaded files
      allow read: if isAuthenticated();
      
      // Allow approved users to upload files
      allow write: if isApprovedUser();
      
      // Allow admins full access
      allow read, write: if isAdmin();
    }
    
    // Blog post images
    match /blog-images/{allPaths=**} {
      // Allow anyone to read blog images (for public posts)
      allow read: if true;
      
      // Allow approved users to upload blog images
      allow write: if isApprovedUser();
      
      // Allow admins full access
      allow read, write: if isAdmin();
    }
    
    // User avatars
    match /avatars/{userId}/{allPaths=**} {
      // Allow anyone to read avatars (for public profiles)
      allow read: if true;
      
      // Allow users to upload/update their own avatar
      allow write: if isOwner(userId);
      
      // Allow admins full access
      allow read, write: if isAdmin();
    }
    
    // Page assets (images, documents, etc.)
    match /page-assets/{allPaths=**} {
      // Allow anyone to read page assets (for public pages)
      allow read: if true;
      
      // Only admins can upload page assets
      allow write: if isAdmin();
    }
    
    // Admin-only files
    match /admin/{allPaths=**} {
      // Only admins can read/write admin files
      allow read, write: if isAdmin();
    }
    
    // Temporary uploads (for processing)
    match /temp/{userId}/{allPaths=**} {
      // Users can upload to their temp folder
      allow write: if isOwner(userId) && isApprovedUser();
      
      // Users can read their own temp files
      allow read: if isOwner(userId);
      
      // Admins have full access
      allow read, write: if isAdmin();
    }
    
    // Backup files (admin only)
    match /backups/{allPaths=**} {
      allow read, write: if isAdmin();
    }
    
    // System files (admin only)
    match /system/{allPaths=**} {
      allow read, write: if isAdmin();
    }
    
    // Default deny rule for any other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}