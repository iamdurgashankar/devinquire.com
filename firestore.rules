rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidEmail(email) {
      return email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }
    
    function isValidString(str, minLength, maxLength) {
      return str is string && str.size() >= minLength && str.size() <= maxLength;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                       isOwner(userId) && 
                       request.resource.data.keys().hasAll(['email', 'displayName', 'role']) &&
                       request.resource.data.role == 'user' &&
                       isValidEmail(request.resource.data.email) &&
                       isValidString(request.resource.data.displayName, 1, 100);
      allow update: if (isOwner(userId) || isAdmin()) &&
                       // Prevent role changes unless admin
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isAdmin()) &&
                       // Validate email if being updated
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']) || 
                        isValidEmail(request.resource.data.email));
      allow delete: if isAdmin();
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if resource.data.status == 'published' || 
                     isAdmin() || 
                     (isAuthenticated() && resource.data.authorId == request.auth.uid);
      allow create: if isAuthenticated() && 
                       request.resource.data.authorId == request.auth.uid &&
                       request.resource.data.keys().hasAll(['title', 'content', 'status', 'authorId']) &&
                       isValidString(request.resource.data.title, 1, 200) &&
                       isValidString(request.resource.data.content, 1, 50000) &&
                       request.resource.data.status in ['draft', 'published'];
      allow update: if (isAdmin() || 
                       (isAuthenticated() && resource.data.authorId == request.auth.uid)) &&
                       // Validate fields if being updated
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['title']) ||
                        isValidString(request.resource.data.title, 1, 200)) &&
                       (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['content']) ||
                        isValidString(request.resource.data.content, 1, 50000));
      allow delete: if isAdmin();
    }

    // Subscriptions collection
    match /subscriptions/{subscriptionId} {
      allow read: if isAdmin();
      allow create: if isValidEmail(request.resource.data.email) && 
                       request.resource.data.keys().hasAll(['email', 'categories', 'status']) &&
                       request.resource.data.status == 'active' &&
                       request.resource.data.categories is list &&
                       request.resource.data.categories.size() > 0;
      allow update: if isAdmin() ||
                       // Allow users to update their own subscription status
                       (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                        request.resource.data.status in ['active', 'unsubscribed']);
      allow delete: if isAdmin();
    }

    // Contact submissions
    match /contact_submissions/{submissionId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message']) &&
                       isValidEmail(request.resource.data.email) &&
                       isValidString(request.resource.data.name, 2, 100) &&
                       isValidString(request.resource.data.message, 10, 5000) &&
                       request.resource.data.status == 'new';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Newsletter campaigns (admin only)
    match /newsletter_campaigns/{campaignId} {
      allow read, write: if isAdmin();
    }

    // Newsletter logs (admin only)
    match /newsletter_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Pages collection
    match /pages/{pageId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // User presence (for online status)
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Firebase Storage security rules
// Note: These should be added to your Firebase Storage rules separately
