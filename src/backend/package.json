{
  "name": "devinquire-backend",
  "version": "1.0.0",
  "description": "Backend API server for DevInquire blog platform with Firebase integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "build": "echo \"No build step required for Node.js\"",
    "deploy": "node deploy-firebase.js",
    "firebase:init": "firebase init",
    "firebase:deploy": "firebase deploy",
    "firebase:emulators": "firebase emulators:start",
    "firebase:test": "node run-firebase-tests.js",
    "db:seed": "node scripts/seed-database.js",
    "db:migrate": "node scripts/migrate-database.js",
    "logs": "pm2 logs",
    "monitor": "pm2 monit",
    "restart": "pm2 restart all",
    "stop": "pm2 stop all",
    "health": "curl -f http://localhost:5000/health || exit 1"
  },
  "keywords": [
    "nodejs",
    "express",
    "firebase",
    "blog",
    "api",
    "backend",
    "devinquire"
  ],
  "author": "DevInquire Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "firebase-admin": "^11.11.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "nodemailer": "^6.9.7",
    "joi": "^17.11.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.6",
    "uuid": "^9.0.1",
    "moment": "^2.29.4",
    "lodash": "^4.17.21",
    "validator": "^13.11.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "express-validator": "^7.0.1",
    "cookie-parser": "^1.4.6",
    "express-session": "^1.17.3",
    "connect-redis": "^7.1.0",
    "redis": "^4.6.10",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "node-cron": "^3.0.3",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "marked": "^9.1.6",
    "dompurify": "^3.0.5",
    "jsdom": "^23.0.1",
    "express-slow-down": "^2.0.1",
    "express-brute": "^1.0.1",
    "express-brute-redis": "^0.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-google-oauth20": "^2.0.0",
    "passport-github2": "^0.1.12",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "express-openapi-validator": "^5.1.2",
    "rate-limiter-flexible": "^4.0.1",
    "express-mongo-sanitize": "^2.2.0",
    "xss": "^1.0.14",
    "hpp": "^0.2.3",
    "express-fileupload": "^1.4.3",
    "mime-types": "^2.1.35",
    "file-type": "^18.7.0",
    "image-size": "^1.0.2",
    "pdf-parse": "^1.1.1",
    "csv-parser": "^3.0.0",
    "xml2js": "^0.6.2",
    "rss": "^1.2.2",
    "sitemap": "^7.1.1",
    "node-cache": "^5.1.2",
    "memory-cache": "^0.2.0",
    "express-cache-controller": "^1.1.0",
    "compression-webpack-plugin": "^10.0.0",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "pm2": "^5.3.0",
    "cluster": "^0.7.7",
    "os": "^0.1.2",
    "path": "^0.12.7",
    "fs-extra": "^11.2.0",
    "archiver": "^6.0.1",
    "unzipper": "^0.10.14",
    "tar": "^6.2.0",
    "glob": "^10.3.10",
    "chokidar": "^3.5.3",
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "rimraf": "^5.0.5",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "inquirer": "^8.2.6",
    "commander": "^11.1.0",
    "yargs": "^17.7.2",
    "debug": "^4.3.4",
    "ms": "^2.1.3",
    "semver": "^7.5.4",
    "update-notifier": "^7.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jest": "^27.6.0",
    "prettier": "^3.1.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "@types/node": "^20.10.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/supertest": "^2.0.16",
    "firebase-functions-test": "^3.1.1",
    "firebase-tools": "^12.9.1",
    "nock": "^13.4.0",
    "sinon": "^17.0.1",
    "nyc": "^15.1.0",
    "codecov": "^3.8.3",
    "jsdoc": "^4.0.2",
    "typedoc": "^0.25.4",
    "madge": "^6.1.0",
    "dependency-cruiser": "^16.0.0",
    "npm-check-updates": "^16.14.12",
    "license-checker": "^25.0.1",
    "bundle-analyzer": "^4.0.0",
    "webpack-bundle-analyzer": "^4.10.1",
    "source-map-support": "^0.5.21",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/devinquire/devinquire.com.git"
  },
  "bugs": {
    "url": "https://github.com/devinquire/devinquire.com/issues"
  },
  "homepage": "https://devinquire.com",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!**/coverage/**",
      "!**/dist/**",
      "!jest.config.js",
      "!**/*.test.js",
      "!**/*.spec.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "eslintConfig": {
    "extends": [
      "airbnb-base",
      "plugin:jest/recommended"
    ],
    "env": {
      "node": true,
      "jest": true,
      "es2022": true
    },
    "rules": {
      "no-console": "warn",
      "no-unused-vars": "error",
      "prefer-const": "error",
      "no-var": "error",
      "object-shorthand": "error",
      "prefer-arrow-callback": "error",
      "consistent-return": "off",
      "no-param-reassign": "off",
      "import/no-extraneous-dependencies": [
        "error",
        {
          "devDependencies": [
            "**/*.test.js",
            "**/*.spec.js",
            "tests/**/*.js",
            "scripts/**/*.js"
          ]
        }
      ]
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "avoid"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ],
    "*.{json,md}": [
      "prettier --write",
      "git add"
    ]
  },
  "nodemonConfig": {
    "watch": [
      "."
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules/",
      "coverage/",
      "dist/",
      "logs/",
      "*.test.js",
      "*.spec.js"
    ],
    "env": {
      "NODE_ENV": "development"
    },
    "delay": "1000"
  },
  "pm2": {
    "apps": [
      {
        "name": "devinquire-backend",
        "script": "server.js",
        "instances": "max",
        "exec_mode": "cluster",
        "env": {
          "NODE_ENV": "production",
          "PORT": 5000
        },
        "error_file": "logs/err.log",
        "out_file": "logs/out.log",
        "log_file": "logs/combined.log",
        "time": true,
        "max_memory_restart": "1G",
        "node_args": "--max-old-space-size=4096",
        "watch": false,
        "ignore_watch": [
          "node_modules",
          "logs",
          "coverage"
        ]
      }
    ]
  }
}