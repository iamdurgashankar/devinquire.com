# =============================================================================
# DevInquire.com (Main Site) — Environment Configuration Template
# -----------------------------------------------------------------------------
# COPY THIS FILE to `.env` and populate real values.
# `.env` is gitignored; `.env.example` documents all supported keys.
# =============================================================================

# ------------------------------
# Runtime
# ------------------------------
NODE_ENV=development
PORT=8000
TRUST_PROXY_HOPS=1

# ------------------------------
# App identity
# ------------------------------
APP_URL=https://devinquire.com
SITE_NAME=DevInquire

# ------------------------------
# API security — rotate these values for every environment
# ------------------------------
# REQUIRED in production, >= 24 chars.
# Generate: node -e "console.log(crypto.randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_JWT_SECRET__48_BYTES_HEX

# Static API key for internal / blog-admin endpoints
API_SECRET_KEY=REPLACE_WITH_API_SECRET_KEY__48_BYTES_HEX

# Blog public feed internal key (shared with dashboard)
BLOG_API_KEY=REPLACE_WITH_BLOG_API_KEY__48_BYTES_HEX

# Webhook token used by the dashboard to trigger blog re-sync on this site.
# MUST match the dashboard server .env MAINSITE_SYNC_WEBHOOK_URL `?token=` value.
SYNC_WEBHOOK_SECRET=REPLACE_WITH_SYNC_WEBHOOK_SECRET__48_BYTES_HEX

# ------------------------------
# Database (MySQL) — for blog / contact / newsletter persistence
# ------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=devinquire_db
DB_POOL_MAX=20

# ------------------------------
# CORS — comma-separated, NO trailing slashes
# ------------------------------
# Dev defaults; production must enumerate exact origins.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,https://devinquire.com,https://www.devinquire.com,https://dashboard.devinquire.com

# ------------------------------
# Dashboard integration (CRITICAL for blog fallback)
# ------------------------------
# Backend sync-posts webhook pulls the public feed from this URL:
DASHBOARD_API_URL=https://dashboard.devinquire.com/api/public
# Local dev override (uncomment in local):
# DASHBOARD_API_URL=http://localhost:8001/api/public

# Frontend FEED FALLBACK (build-time variable used by blogApiService.js).
# When `npm run build` is executed, this value is INLINED into the JS bundle.
# Must be set at BUILD TIME, not runtime, for react-scripts/CRA.
REACT_APP_DASHBOARD_API_URL=https://dashboard.devinquire.com/api/public
# Local dev override (uncomment in local):
# REACT_APP_DASHBOARD_API_URL=http://localhost:8001/api/public

# ------------------------------
# Supabase (optional — main site frontend DB + auth)
# ------------------------------
SUPABASE_URL=https://mcyngpjwkcxodglewdwd.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY_PUBLIC
# NEVER commit SUPABASE_SECRET_KEY — keep it only in your secret manager:
# SUPABASE_SECRET_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# ------------------------------
# Firebase (optional — frontend auth)
# ------------------------------
REACT_APP_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_API_KEY
REACT_APP_FIREBASE_AUTH_DOMAIN=REPLACE.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=REPLACE
REACT_APP_FIREBASE_STORAGE_BUCKET=REPLACE.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=000000000000
REACT_APP_FIREBASE_APP_ID=REPLACE
REACT_APP_FIREBASE_MEASUREMENT_ID=G-REPLACE

# ------------------------------
# Outbound Email — contact form / newsletter confirmations
# ------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_NAME=DevInquire
MAIL_FROM_ADDRESS=noreply@devinquire.com
ADMIN_EMAIL=admin@devinquire.com

# ------------------------------
# Feature flags
# ------------------------------
PUBLIC_BLOG_FEED_ENABLED=true
NEWSLETTER_ENABLED=true
