# ==============================================================================
# Hostinger Shared Hosting — Main Website Backend (.env)
# ------------------------------------------------------------------------------
# In Hostinger File Manager:
# 1. Rename this file to `.env` (or create a new file named `.env`).
# 2. Update the values below with your Hostinger database & production secrets.
# ==============================================================================

NODE_ENV=production
PORT=8000
TRUST_PROXY_HOPS=1

# Security Keys (Must be strong, minimum 32 chars)
# Generate via terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_strong_jwt_secret_minimum_32_characters
API_SECRET_KEY=replace_with_strong_api_secret_minimum_32_characters
BLOG_API_KEY=replace_with_strong_blog_api_key_minimum_32_characters
SYNC_WEBHOOK_SECRET=replace_with_strong_sync_webhook_secret_min_32_chars

# Hostinger MySQL Database Settings
# (Find these in Hostinger hPanel -> Databases -> MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_dbuser
DB_PASS=your_hostinger_mysql_password
DB_NAME=u123456789_dbname
DB_POOL_MAX=20

# CORS Allowed Origins (Comma-separated, no trailing slash)
ALLOWED_ORIGINS=https://devinquire.com,https://www.devinquire.com,https://dashboard.devinquire.com

# Dashboard Public Feed URL (Used for blog sync fallback)
DASHBOARD_API_URL=https://dashboard.devinquire.com/api/public

# Outbound Email (SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=contact@devinquire.com
SMTP_PASSWORD=your_email_password
MAIL_FROM_NAME="DevInquire"
MAIL_FROM_ADDRESS=contact@devinquire.com
ADMIN_EMAIL=contact@devinquire.com

# Supabase (Optional fallback)
SUPABASE_URL=https://mcyngpjwkcxodglewdwd.supabase.co
SUPABASE_ANON_KEY=
